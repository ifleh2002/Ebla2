{
  "entities": {
    "LotInventoryItem": {
      "title": "LotInventoryItem",
      "description": "Persistent override or state synchronization for an Ebla Two apartment or commercial shop lot.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique lot identifier (e.g. A-001, MAG-01)"
        },
        "statut": {
          "type": "string",
          "maxLength": 32,
          "enum": ["Disponible", "Réservé", "Affecté", "Vendu"],
          "description": "Commercial status of the lot"
        },
        "prixAuM2": {
          "type": "number",
          "description": "Price per square meter in MAD"
        },
        "prixTotal": {
          "type": "number",
          "description": "Total price in MAD"
        },
        "surfaceTotale": {
          "type": "number",
          "description": "Total surface area in m2"
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the authenticated user who updated the lot"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["id", "statut", "prixAuM2", "prixTotal", "surfaceTotale", "updatedByUid", "updatedAt"]
    },
    "ReservationRecord": {
      "title": "ReservationRecord",
      "description": "Adhesion and lot reservation dossier submitted by an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reservation ID"
        },
        "lotId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target lot ID"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the applicant"
        },
        "nomClient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Full name of the applicant"
        },
        "cin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "National ID card number"
        },
        "telephone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Phone number"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Email address"
        },
        "modeFinancement": {
          "type": "string",
          "maxLength": 64,
          "enum": ["Echeancier Amicale (4 Tranches)", "Comptant"],
          "description": "Payment schedule type"
        },
        "statut": {
          "type": "string",
          "maxLength": 32,
          "enum": ["En attente", "Validée", "Refusée"],
          "description": "Validation status of the reservation"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "lotId",
        "ownerId",
        "nomClient",
        "cin",
        "telephone",
        "email",
        "modeFinancement",
        "statut",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteVisitRecord": {
      "title": "SiteVisitRecord",
      "description": "Scheduled on-site or virtual 3D visit for Residence Ebla Two.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Visit appointment ID"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the visitor"
        },
        "lotId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Optional lot ID or GENERAL"
        },
        "nomVisiteur": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Full name of the visitor"
        },
        "telephone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Visitor phone number"
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Appointment date"
        },
        "creneau": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Appointment time slot"
        },
        "typeVisite": {
          "type": "string",
          "maxLength": 64,
          "enum": ["Sur place (Chantier Mansouria)", "Visioconférence WhatsApp 3D"],
          "description": "Visit format"
        },
        "statut": {
          "type": "string",
          "maxLength": 32,
          "enum": ["Confirmée", "Effectuée", "Annulée"],
          "description": "Appointment status"
        },
        "calendarEventId": {
          "type": "string",
          "maxLength": 128,
          "description": "Synced Google Calendar event ID"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "ownerId",
        "lotId",
        "nomVisiteur",
        "telephone",
        "date",
        "creneau",
        "typeVisite",
        "statut",
        "calendarEventId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Executive board administrator marker document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin Firebase UID"
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Admin email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/lots/{lotId}": {
      "schema": "LotInventoryItem",
      "description": "Publicly readable inventory of the 162 apartments and 9 shops; writable by verified admins or during reservation."
    },
    "/reservations/{reservationId}": {
      "schema": "ReservationRecord",
      "description": "PII-isolated reservation dossiers restricted to the document owner or verified admins."
    },
    "/siteVisits/{visitId}": {
      "schema": "SiteVisitRecord",
      "description": "PII-isolated site visit appointments restricted to the document owner or verified admins."
    },
    "/admins/{adminUid}": {
      "schema": "AdminRecord",
      "description": "Trusted admin lookup collection for the Executive Board."
    }
  }
}
